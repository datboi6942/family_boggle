# Family Boggle Backend Environment Variables
# Copy this file to .env and fill in values

# JWT Secret Key (REQUIRED for production)
# Generate with: openssl rand -hex 32
BOGGLE_SECRET_KEY=your-secret-key-here-change-in-production

# CORS Allowed Origins (comma-separated)
# Default: http://localhost:5173,http://localhost:2727
BOGGLE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:2727

# Database URL (SQLite by default)
BOGGLE_DATABASE_URL=sqlite:///./family_boggle.db

# Debug mode (set to False in production)
BOGGLE_DEBUG=True

# Server host and port
BOGGLE_HOST=0.0.0.0
BOGGLE_PORT=8000